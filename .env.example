# Copy to .env (gitignored). Loaded by legal_ft.config.
# Keep the ~15GB model cache off the C: drive.
HF_HOME=D:/hf_cache
# Only needed for pushing the adapter to the Hub (write token).
HF_TOKEN=
# Silence the Windows no-symlink cache warning (cache still works, just copies files)
HF_HUB_DISABLE_SYMLINKS_WARNING=1
